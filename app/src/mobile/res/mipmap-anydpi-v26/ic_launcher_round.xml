<?xml version="1.0" encoding="utf-8"?>
<!--
  Icono adaptativo del móvil: el mismo logo cuadrado que la TV (src/main/res/drawable-*/ic_launcher.png),
  como capa de fondo en mipmap-*dpi; el lanzador le aplica su forma (círculo, squircle…). Sin capa
  monocroma: con los iconos temáticos de Android 13+ se ve igual. Solo en el sabor mobile: el de la
  TV sigue en drawable porque Fire OS no muestra los mipmap.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
