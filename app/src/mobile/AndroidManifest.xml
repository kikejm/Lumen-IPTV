<?xml version="1.0" encoding="utf-8"?>
<!-- Sabor mobile (teléfonos y tabletas Android): se combina con src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.software.picture_in_picture" android:required="false" />

    <application>
        <!--
          Sin screenOrientation: la app funciona en vertical y en horizontal.
          configChanges evita recrear la Activity al girar (el vídeo no se corta).
        -->
        <activity
            android:name=".MobileActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Configuraciones WireGuard (.conf) de Proton: «Abrir con» y «Compartir» desde Archivos,
              el navegador o el correo. Android no conoce la extensión .conf, así que llegan como
              octet-stream o texto; MobileActivity valida el contenido antes de importarlo.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-wireguard-profile" />
                <data android:mimeType="application/x-wireguard-config" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/x-wireguard-profile" />
                <data android:mimeType="application/x-wireguard-config" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
