<?xml version="1.0" encoding="utf-8"?>
<!-- La mayoría de proveedores IPTV sirven por HTTP plano: se permite cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
