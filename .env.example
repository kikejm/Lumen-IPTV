# =============================================================================
# Lumen TV — configuración de build
# Copia este fichero a `.env` (está en .gitignore) y rellena lo que necesites.
# Todo es OPCIONAL: sin .env la app compila y se configura desde la propia tele.
# En CI (GitHub Actions) los mismos nombres se leen como variables de entorno/secrets.
# =============================================================================

# --- Lista IPTV precargada en el formulario de alta (opcional) ---------------
# OJO: si los rellenas, quedan dentro del APK. Úsalo solo para tu uso personal.
LUMEN_DEFAULT_PLAYLIST_NAME=
LUMEN_DEFAULT_XTREAM_SERVER=
LUMEN_DEFAULT_XTREAM_USERNAME=
LUMEN_DEFAULT_XTREAM_PASSWORD=
LUMEN_DEFAULT_M3U_URL=
LUMEN_DEFAULT_EPG_URL=

# --- VPN: empaquetar configuraciones WireGuard de Proton en el APK ----------
# Si es true, se copian los *.conf de LUMEN_VPN_CONFIG_DIR a los assets y la app
# los importa al arrancar. Contienen tu clave privada: el APK pasa a ser secreto.
LUMEN_BUNDLE_VPN_CONFIGS=false
LUMEN_VPN_CONFIG_DIR=vpn-configs

# --- Actualizaciones OTA ------------------------------------------------------
# Opción A (recomendada): GitHub Releases. Formato owner/repo.
LUMEN_UPDATE_GITHUB_REPO=kikejm/IPTV-Fire-Stick-TV
# Solo si el repo es privado: token fine-grained con permiso "Contents: Read-only"
# sobre ESTE repo. Queda dentro del APK, así que dale el mínimo permiso posible.
LUMEN_UPDATE_GITHUB_TOKEN=
# Opción B: URL a un update.json propio (ignorada si hay repo de GitHub).
LUMEN_UPDATE_MANIFEST_URL=

# --- Firma del APK release ----------------------------------------------------
# Las actualizaciones solo se instalan si TODAS las versiones van firmadas con la
# misma clave. Guarda una copia del .jks fuera del repo: si la pierdes, tendrás que
# desinstalar la app para volver a instalarla.
LUMEN_KEYSTORE_PATH=keystore/lumen-release.jks
LUMEN_KEYSTORE_PASSWORD=
LUMEN_KEY_ALIAS=lumen
LUMEN_KEY_PASSWORD=

# --- Varios -------------------------------------------------------------------
LUMEN_SPEEDTEST_URL=https://speed.cloudflare.com/__down?bytes=25000000
LUMEN_IMPORT_SERVER_PORT=8765
# Sobrescriben lumen.versionCode/versionName de gradle.properties (útil en CI).
LUMEN_VERSION_CODE=
LUMEN_VERSION_NAME=
